with gr.Blocks(title="Study Mitra", theme=gr.themes.Soft(), css=custom_css) as demo:

    # State variables
    video_path_state = gr.State()
    transcript_state = gr.State()

    # --- HEADER ---
    with gr.Row():
        with gr.Column():
            gr.Markdown(
                """
                # Study Mitra
                """
            )

    # --- TOP SECTION ---
